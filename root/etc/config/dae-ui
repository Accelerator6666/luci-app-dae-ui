config main 'main'
	option enabled '1'
	option binary '/usr/bin/dae'
	option init '/etc/init.d/dae'
	option config_file '/etc/dae/config.dae'
	option log_file '/var/log/dae/dae.log'
	option native_api 'auto'
	option version_manager_enabled '0'
	option selected_slot 'system'
	option last_good_slot 'system'
	option dashboard_dir '/usr/share/dae-ui/dashboard'
